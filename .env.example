# ============================================================
#  Скопируйте этот файл в .env и заполните своими значениями
#  cp .env.example .env
# ============================================================

# --- Обязательное ---

# Токен сообщества ВК.
# Получить: https://vk.com/groups → Управление → Работа с API → Создать ключ.
# Права: "Управление сообществом" + "Сообщения сообщества" + "Фотографии сообщества".
# Не забудьте включить Long Poll API в той же вкладке.
# Long Poll API → "Типы событий" → отметьте "Входящие сообщения".
VK_TOKEN=

# ID сообщества ВК (число из vk.com/clubXXXXXXXX).
# Нужен для загрузки изображений расписания в сообщения.
# Найти: настройки сообщества → "Адрес" → "Номер сообщества",
# либо взять цифры из URL: vk.com/club241466586 → VK_GROUP_ID=241466586.
VK_GROUP_ID=


# --- Админы ---

# ID пользователей ВК, которым разрешены админ-команды:
#   /group, /subscribers, /unsubscribe, /interval, /test, /metrics, /week_skip
# Несколько ID — через запятую, без пробелов.
# Узнать свой ID: написать боту команду /whoami.
# Если оставить пустым — админ-команды будут недоступны никому.
ADMIN_USER_IDS=

# ID получателя для служебных сообщений (приветствие при старте).
# Может быть личкой (>0) или беседой (<0).
# Узнать: написать боту /whoami в нужном чате.
# Если оставить пустым — приветствие не отправляется.
ADMIN_PEER_ID=


# --- Опциональное ---

# Путь к файлу базы данных SQLite.
# В Docker имеет смысл указать /app/data/bot.db и смонтировать volume.
DB_PATH=bot.db

# Интервал между циклами проверки расписания (в минутах).
# Минимум 5 (защита от банов), рекомендуется 20–30.
CHECK_INTERVAL_MINUTES=30

# Часовой пояс (для Linux/Docker). На Windows игнорируется.
# Примеры: Asia/Yekaterinburg, Europe/Moscow, UTC.
TZ=Asia/Yekaterinburg

# Кулдаун для команд (секунды). Повторная команда того же имени
# от того же пользователя в том же чате будет проигнорирована.
# /whoami — без ограничений. 0 = отключить кулдаун.
COMMAND_COOLDOWN_SECONDS=6